rules_version = '2';

// Each account can only read and change its own data:
//   users/{user id}               the account's settings (its Google Calendar)
//   users/{user id}/cats/{id}     its cats
//   users/{user id}/photos/{id}   each cat's photo (a small JPEG, kept apart so
//                                 ticking a dose doesn't re-send the photo)
// Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidSettings(settings) {
      return settings.keys().hasOnly(['calendarId', 'calendarEmail', 'updatedAt'])
        && settings.get('calendarId', '') is string && settings.get('calendarId', '').size() <= 300
        && settings.get('calendarEmail', '') is string && settings.get('calendarEmail', '').size() <= 320
        && settings.updatedAt == request.time;
    }

    function isValidCat(cat) {
      return cat.keys().hasOnly(['name', 'birthDate', 'sex', 'outdoor', 'coat', 'notes', 'records', 'updatedAt'])
        && cat.keys().hasAll(['name', 'birthDate', 'records', 'updatedAt'])
        && cat.name is string && cat.name.size() > 0 && cat.name.size() <= 60
        && cat.birthDate is string && cat.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && cat.get('sex', '') in ['', 'female', 'male']
        && cat.get('outdoor', false) is bool
        && cat.get('coat', '') is string && cat.get('coat', '').size() <= 20
        && cat.get('notes', '') is string && cat.get('notes', '').size() <= 1000
        && cat.records is list && cat.records.size() <= 1000
        && cat.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidSettings(request.resource.data);
    }

    match /users/{userId}/cats/{catId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidCat(request.resource.data);
    }

    match /users/{userId}/photos/{catId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['dataUrl', 'updatedAt'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 300000
        && request.resource.data.dataUrl.matches('^data:image/(jpeg|png|webp);base64,.*')
        && request.resource.data.updatedAt == request.time;
    }
  }
}
